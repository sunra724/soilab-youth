# 기존 Supabase 서버 설정 사용. 아래 토큰은 32자 이상 임의 문자열.
BRIEFING_INGEST_TOKEN=
# 이전 설정 이름을 함께 사용할 경우 위 값과 동일하게 설정합니다.
YOUTH_BRIEFING_INGEST_TOKEN=
# 실제로 연결한 공개 채널만 입력. 비워두면 가입 버튼을 표시하지 않습니다.
YOUTH_BRIEFING_CHANNEL_URL=

# Server only: automatic collection and editorial review
NKIS_API_KEY=
# Read-only KOSIS candidate preview. Kept server-side; not enabled in cron yet.
KOSIS_API_KEY=
LAW_GO_KR_OC=
# Use the referer registered for the existing API service; this is not the site's canonical URL.
LAW_GO_KR_REFERER=
YOUTH_RESEARCH_REVIEW_TOKEN=
# Vercel passes this token to the collection cron routes.
CRON_SECRET=
# Separate youth channel; never use the newsletter's default bot/chat as a fallback.
YOUTH_BRIEFING_BOT_TOKEN=
YOUTH_BRIEFING_CHAT_ID=
YOUTH_BRIEFING_ENABLED=false
YOUTH_BRIEFING_MODEL=claude-sonnet-4-6

# Private Sheet mirror. Keep false until the DB migration and Google permission checks pass.
YOUTH_LEDGER_ENABLED=false
YOUTH_LEDGER_SHEET_ID=
# Server secret: service-account JSON. Never use NEXT_PUBLIC_ or commit a real key.
# Share the target Sheet with that service account as Editor; use Sheets API scope only.
YOUTH_LEDGER_GOOGLE_SERVICE_ACCOUNT_JSON=
